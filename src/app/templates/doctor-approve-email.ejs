<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Account Approved</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f1f5f9;
    font-family: Arial, Helvetica, sans-serif;
">

    <div style="
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    ">

        <!-- Header -->
        <div style="
            padding: 35px 25px;
            text-align: center;
            background-color: #0f766e;
            color: #ffffff;
        ">
            <div style="
                width: 64px;
                height: 64px;
                margin: 0 auto 16px;
                background-color: #ffffff;
                color: #0f766e;
                border-radius: 50%;
                font-size: 38px;
                line-height: 64px;
                font-weight: bold;
            ">✓</div>

            <h1 style="
                margin: 0;
                font-size: 26px;
                line-height: 1.4;
            ">
                Congratulations!
            </h1>

            <p style="
                margin: 10px 0 0;
                font-size: 15px;
                color: #ccfbf1;
            ">
                Your Doctor Account Has Been Approved
            </p>
        </div>

        <!-- Main Content -->
        <div style="padding: 35px 30px;">

            <h2 style="
                margin: 0 0 18px;
                color: #0f172a;
                font-size: 22px;
            ">
                Hello Dr. <%= name %>,
            </h2>

            <p style="
                margin: 0 0 16px;
                color: #475569;
                font-size: 15px;
                line-height: 1.8;
            ">
                We are pleased to inform you that your application
                to join our healthcare platform has been approved
                successfully.
            </p>

            <p style="
                margin: 0 0 25px;
                color: #475569;
                font-size: 15px;
                line-height: 1.8;
            ">
                Welcome to our healthcare community! Your account
                is now ready. You can log in using the credentials
                provided below.
            </p>

            <!-- Login Credentials -->
            <div style="
                margin: 25px 0;
                padding: 24px;
                background-color: #f0fdfa;
                border: 1px solid #ccfbf1;
                border-radius: 10px;
            ">
                <h3 style="
                    margin: 0 0 20px;
                    color: #115e59;
                    font-size: 18px;
                ">
                    Your Login Credentials
                </h3>

                <p style="
                    margin: 0 0 8px;
                    color: #64748b;
                    font-size: 13px;
                ">
                    EMAIL ADDRESS
                </p>

                <p style="
                    margin: 0 0 20px;
                    padding: 12px;
                    background-color: #ffffff;
                    border: 1px solid #e2e8f0;
                    border-radius: 6px;
                    color: #0f172a;
                    font-size: 15px;
                    word-break: break-all;
                ">
                    <%= email %>
                </p>

                <p style="
                    margin: 0 0 8px;
                    color: #64748b;
                    font-size: 13px;
                ">
                    TEMPORARY PASSWORD
                </p>

                <p style="
                    margin: 0;
                    padding: 12px;
                    background-color: #ffffff;
                    border: 1px solid #e2e8f0;
                    border-radius: 6px;
                    color: #0f766e;
                    font-family: monospace;
                    font-size: 16px;
                    font-weight: bold;
                    word-break: break-all;
                ">
                    <%= password %>
                </p>
            </div>

            <!-- Security Notice -->
            <div style="
                margin: 25px 0;
                padding: 16px;
                background-color: #fffbeb;
                border-left: 4px solid #f59e0b;
                border-radius: 6px;
            ">
                <p style="
                    margin: 0;
                    color: #92400e;
                    font-size: 14px;
                    line-height: 1.7;
                ">
                    <strong>Security Notice:</strong>
                    Please log in with the credentials above and
                    change your temporary password as soon as possible.
                    Never share your password with anyone.
                </p>
            </div>

            <p style="
                margin: 25px 0;
                color: #475569;
                font-size: 15px;
                line-height: 1.8;
            ">
                Thank you for joining us. We look forward to having
                you as part of our team and helping you provide
                quality healthcare services to patients.
            </p>

            <p style="
                margin: 0;
                color: #334155;
                font-size: 15px;
                line-height: 1.8;
            ">
                Best regards,<br>
                <strong style="color: #0f766e;">
                    Healthcare Team
                </strong>
            </p>

        </div>

        <!-- Footer -->
        <div style="
            padding: 22px 25px;
            background-color: #f8fafc;
            border-top: 1px solid #e2e8f0;
            text-align: center;
        ">
            <p style="
                margin: 0 0 8px;
                color: #64748b;
                font-size: 12px;
                line-height: 1.6;
            ">
                This is an automated email. Please do not reply directly.
            </p>

            <p style="
                margin: 0;
                color: #94a3b8;
                font-size: 12px;
            ">
                &copy; <%= new Date().getFullYear() %> Healthcare Platform.
                All rights reserved.
            </p>
        </div>

    </div>

</body>
</html>

