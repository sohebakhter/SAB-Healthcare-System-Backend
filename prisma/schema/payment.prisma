model Payment {
    id String @id @default(uuid())

    status   PaymentStatus @default(UNPAID)
    amount   Decimal       @db.Decimal(10, 2)
    currency String        @default("BDT")

    paymentGateway        String @default("bkash")
    merchantInvoiceNumber String @unique //appointment id

    bkashPaymentId String? @unique
    bkashTrxId     String?
    payerReference String? //user email or number
    paidAt         String?

    getwayResponse Json?

    refundTrxId  String?
    refundAmount Decimal? @db.Decimal(10, 2)
    refundReason String?
    refundedAt   String?

    appointmentId String      @unique
    appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    creadteAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("payments")
}
